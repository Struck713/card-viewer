# Origin of the catalog/stats JSON API. No trailing slash.
#
# The real catalog origin, published by the game's own team. This is the
# default for local dev as well as production — it's public, anonymous and
# wildcard-CORS, so there's nothing to run locally to use it:
NEXT_PUBLIC_CATALOG_ORIGIN=https://cardgame-catalog-production.up.railway.app

# Alternative: serve test/fixtures/ with `npm run dev:fixtures`
# (http://localhost:8081) to exercise the suppression/empty-state paths the
# real origin has no data for — notably anything stats-related, since the
# stats API isn't published yet. See docs/suppression-and-states.md.
#   NEXT_PUBLIC_CATALOG_ORIGIN=http://localhost:8081
