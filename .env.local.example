# Origin of the catalog/stats JSON API. No trailing slash.
#
# Local dev options (see docs/catalog-hosting.md):
#   1. Run the real catalog server from the submodule:
#        cd vendor/cardgame/catalog && npm start   # http://localhost:8080
#   2. Serve test/fixtures/ with `npm run dev:fixtures` (http://localhost:8081)
#      to exercise suppression/empty-state paths the real server has no data for.
NEXT_PUBLIC_CATALOG_ORIGIN=http://localhost:8080
